# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env` ke Git.
# Contoh: cp .env.example .env

# String acak panjang untuk menandatangani JWT (WAJIB diganti).
# Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Kredensial MySQL (boleh pakai default untuk testing lokal).
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_PASSWORD=absensi
